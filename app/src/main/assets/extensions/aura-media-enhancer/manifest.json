{
  "manifest_version": 2,
  "name": "Aura Media & Background Enhancer",
  "version": "1.1.0",
  "description": "Keeps YouTube playing when Aura is in the background and can hide the Shorts shelf.",
  "browser_specific_settings": {
    "gecko": {
      "id": "aura-media-enhancer@aura.browser",
      "strict_min_version": "115.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": ["content.js"],
      "css": ["shorts.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ]
}
